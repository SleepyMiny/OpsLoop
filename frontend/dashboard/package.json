{
  "name": "opsloop-exhibition-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "OpsLoop exhibition dashboard. Explicit Demo, read-only Live BFF, and historical ObserveOnly Evidence Replay.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:public": "node scripts/build-public.mjs",
    "test:public-build": "node scripts/public-build.test.mjs",
    "build:status": "node scripts/build-status.mjs",
    "typecheck:status-worker": "tsc --noEmit -p ../../worker/tsconfig.json",
    "test:status-build": "node scripts/status-build.test.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
