# Copy to the gitignored kustomization.yaml and fill values from the CI publish summary.
resources:
  - ../demo-api
  - ../../config/default          # after P3-c
  # Enforce requires the approved writer transition, not just uncommenting RBAC.
  # See docs/runbooks/controller-writer-transition.md. For its reviewed successor
  # image, replace ../../config/default with the following base resources:
  # - ../../config/crd
  # - ../../config/rbac
  # - ../../config/manager-fenced
  # Then, separately after the legacy-writer gate and explicit Enforce approval:
  # - ../../config/rbac/enforce
  # Also replace the opsloop-controller image key below with
  # opsloop-controller-fenced-v1 and pin its newly reviewed successor digest.
  # The previously published 9e7f91b image does NOT contain this protocol.
images:
  - name: demo-api
    newName: REPLACE_ACR_LOGIN_SERVER/opsloop/demo-api
    digest: sha256:REPLACE_INDEX_DIGEST
  - name: opsloop-controller
    newName: REPLACE_ACR_LOGIN_SERVER/opsloop/controller
    digest: sha256:REPLACE_INDEX_DIGEST
