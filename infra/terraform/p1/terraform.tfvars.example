# Nonsecret example. Subscription, ACR name and SSH key are placeholders.
# WARNING: Keep deployment_prerequisites_confirmed=false until verification.
# 2026-10-13 selected candidate: eastasia / Standard_B2pls_v2.
# Allowed Locations policy permits eastasia; Korea/Japan are excluded.
# ARM64, 2 vCPU/4 GiB, accelerated networking, restrictions [], regional 0/6,
# standardBpsv2Family 0/10, exact Ubuntu image Arm64/V2/plan null confirmed.
# B-series CPU credits differ from Dplsv6; actual capacity is unverified.
# Compute/Network/Storage/ContainerRegistry Registered; no auto-registration.
# Exact image minimum OS disk size is unknown; 32 GiB remains conditional.
# Remote backend init/connection verified; real config stays outside Git.
# User-confirmed credit: USD 100; expiry, budget and bootstrap unresolved.
# Evidence: docs/experiments/p1-c-azure-allowed-regions.md.
# Latest: docs/experiments/p1-d-azure-backend-initialization.md.
# Procedures: docs/runbooks/azure-arm64-deployment.md.
deployment_prerequisites_confirmed = false
# Proposed address ranges do not overlap these supplied ranges:
# LAN 192.168.45.0/24, Docker 172.17.0.0/16, Tailscale 100.64.0.0/10,
# Pod 10.42.0.0/16, Service 10.43.0.0/16. These are not Azure resources.
# Additional host/VPN routes and subnet containment need inventory review if
# these defaults change; Terraform schema validation does not verify routing.
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastasia"
acr_name        = "REPLACEWITHUNIQUENAME"
acr_sku         = "Basic"
ssh_public_key  = "REPLACE_WITH_OPENSSH_RSA_PUBLIC_KEY"

ubuntu_image = {
  publisher = "Canonical"
  offer     = "ubuntu-24_04-lts"
  sku       = "server-arm64"
  version   = "24.04.202609040"
}

vm_size                   = "Standard_B2pls_v2"
vnet_cidr                 = "10.80.0.0/16"
subnet_cidr               = "10.80.1.0/24"
os_disk_size_gb           = 32
bootstrap_ssh_source_cidr  = null
# Optional temporary operator exception, never a wider prefix:
# bootstrap_ssh_source_cidr = "203.0.113.10/32"
# This deployment candidate is fixed; region/size changes need another review.
# Never duplicate assignments or open the gate before all prerequisites pass.
