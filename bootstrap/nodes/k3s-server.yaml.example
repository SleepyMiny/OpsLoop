# Nonsecret P1-B template; not installed or executed in P1-A.
# Install exactly v1.35.9+k3s1; YAML is configuration, not a version selector.
# Replace node identity/IP and validate the existing cluster before bootstrap.
node-name: REPLACE_WITH_LAPTOP_VM_NODE_NAME
node-ip: REPLACE_WITH_LAPTOP_VM_TAILSCALE_IPV4
advertise-address: REPLACE_WITH_LAPTOP_VM_TAILSCALE_IPV4
flannel-iface: tailscale0
flannel-backend: vxlan
disable:
  - traefik
  - servicelb
cluster-cidr: 10.42.0.0/16
service-cidr: 10.43.0.0/16
cluster-dns: 10.43.0.10
tls-san:
  - REPLACE_WITH_LAPTOP_VM_TAILSCALE_IPV4
write-kubeconfig-mode: "0600"
# Keep the generated server token and kubeconfig outside Git/Terraform.
